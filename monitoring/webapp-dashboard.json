{
  "title": "Webapp Health",
  "uid": "webapp-health",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Healthy pods",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "targets": [ { "refId": "A", "expr": "sum(up{namespace=\"webapp\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] } },
    { "id": 2, "type": "stat", "title": "Error rate",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "targets": [ { "refId": "A", "expr": "100 * (sum(rate(app_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(app_requests_total[5m]))" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 }, "overrides": [] } },
    { "id": 3, "type": "stat", "title": "Pod restarts",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "targets": [ { "refId": "A", "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"webapp\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] } },
    { "id": 4, "type": "timeseries", "title": "Request rate by endpoint",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [ { "refId": "A", "expr": "sum by (endpoint) (rate(app_requests_total{namespace=\"webapp\"}[1m]))", "legendFormat": "{{endpoint}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] } },
    { "id": 5, "type": "timeseries", "title": "Latency p95",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(app_request_latency_seconds_bucket[5m])))", "legendFormat": "p95" } ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 6, "type": "timeseries", "title": "CPU per pod",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"webapp\", container=\"webapp\"}[5m]))", "legendFormat": "{{pod}}" } ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] } },
    { "id": 7, "type": "timeseries", "title": "Memory per pod",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"webapp\", container=\"webapp\"})", "legendFormat": "{{pod}}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } }
  ]
}
